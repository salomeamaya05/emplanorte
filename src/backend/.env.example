# Base de datos PostgreSQL / Supabase
DATABASE_URL=jdbc:postgresql://HOST:5432/postgres?sslmode=require
DB_USERNAME=postgres.PROJECT_REF
DB_PASSWORD=REEMPLAZAR

# Origen permitido del frontend publicado
CORS_ALLOWED_ORIGINS=https://emplanorte-2-front.onrender.com

# Use una cadena aleatoria de al menos 32 caracteres y manténgala solo en Render.
AUTH_TOKEN_SECRET=REEMPLAZAR_POR_UNA_CLAVE_ALEATORIA_DE_AL_MENOS_32_CARACTERES
# Duración de la sesión en horas. El valor predeterminado también es 24.
AUTH_TOKEN_DURATION_HOURS=24

# Supabase Storage privado para facturas recibidas
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REEMPLAZAR_SOLO_EN_BACKEND
# Alternativa legacy compatible: SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_STORAGE_BUCKET=facturas-proveedores
